  {
    "Id": 6,
    "Title": "\u05DE\u05D9\u05D5\u05D6\u05DE\u05D4 \u05D7\u05D1\u05E8\u05EA\u05D9\u05EA \u05DC\u05D4\u05DB\u05E8\u05D7 \u05E2\u05E1\u05E7\u05D9",
    "Body": "\u05D0\u05DD \u05E0\u05EA\u05E7\u05DC\u05EA\u05DD \u05DC\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4 \u05D1-Buzzwords \u05D7\u05D3\u05E9\u05D9\u05DD \u0022\u05D4\u05E9\u05E7\u05E2\u05D5\u05EA \u05D0\u05D7\u05E8\u05D0\u05D9\u05D5\u05EA\u0022 \u05D0\u05D5 \u0022\u05D4\u05E9\u05E7\u05E2\u05D5\u05EA ESG (Environmental, Social, and Governance)\u0022, \u05D3\u05E2\u05D5 \u05E9\u05DC\u05D0 \u05DE\u05D3\u05D5\u05D1\u05E8 \u05D1\u05E8\u05E2\u05D9\u05D5\u05DF \u05D7\u05D3\u05E9 \u05D0\u05DC\u05D0 \u05D1\u05E9\u05DD \u05E7\u05D5\u05D3 \u05DE\u05E2\u05D5\u05D3\u05DB\u05DF \u05DC\u05E2\u05D5\u05DC\u05DD \u05EA\u05D5\u05DB\u05DF \u05D5\u05EA\u05D9\u05E7",
    "Author": "\u05E2\u05E0\u05D1\u05DC \u05E9\u05D8\u05E8\u05E0\u05D1\u05E8\u05D2",
    "CreatedAt": "May 31, 2026",
    "ImageUrl": "https://www.iai.co.il/heb/sites/heb/files/2021-07/from-social-initiative-to-business-necessity_1920x525.jpg",
    "Latitude": 31.945676300520876,
    "Longitude": 34.89181221296807,
    "City": "\u05DC\u05D5\u05D3"
  },
  {
    "Id": 7,
    "Title": "\u05E2\u05DC \u05D4\u05D5\u05DF \u05D0\u05E0\u05D5\u05E9\u05D9, \u05D2\u05D9\u05D5\u05D5\u05DF \u05EA\u05E2\u05E1\u05D5\u05E7\u05EA\u05D9 \u05D5\u05EA\u05D5\u05E6\u05D0\u05D5\u05EA \u05E2\u05E1\u05E7\u05D9\u05D5\u05EA \u05D8\u05D5\u05D1\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8",
    "Body": "\u05D2\u05D9\u05D5\u05D5\u05DF \u05EA\u05E2\u05E1\u05D5\u05E7\u05EA\u05D9 \u05D4\u05D5\u05D0 \u05D4\u05E8\u05D1\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05E6\u05DE\u05D3 \u05DE\u05D9\u05DC\u05D9\u05DD \u05D8\u05E8\u05E0\u05D3\u05D9\u05D5\u05EA \u05E9\u05E0\u05E9\u05DE\u05E2\u05D5\u05EA \u05D1\u05E9\u05E0\u05D9\u05DD \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8 \u05D5\u05D9\u05D5\u05EA\u05E8 \u05DE\u05E4\u05D9 \u05DE\u05E0\u05D4\u05DC\u05D9\u05DD \u05D1\u05DB\u05D9\u05E8\u05D9\u05DD \u05D5\u05DE\u05E0\u05D4\u05DC\u05D9 \u05DE\u05E9\u05D0\u05D1\u05D9 \u05D0\u05E0\u05D5\u05E9. \u05D4\u05EA\u05E2\u05E9\u05D9\u05D9\u05D4 \u05D4\u05D0\u05D5\u05D5\u05D9\u05E8\u05D9\u05EA, \u05DB\u05D0\u05D7\u05D3 \u05D4\u05DE\u05E2\u05E1\u05D9\u05E7\u05D9\u05DD \u05D4\u05D2\u05D3\u05D5\u05DC\u05D9\u05DD \u05D1\u05DE\u05D3\u05D9\u05E0\u05D4, \u05E4\u05D5\u05E2\u05DC\u05EA \u05DE\u05EA\u05D5\u05DA \u05DE\u05D7\u05D5\u05D9\u05D1\u05D5\u05EA \u05D5\u05D4\u05D1\u05E0\u05D4 \u05E9\u05DE\u05D9\u05E0\u05D5\u05E4\u05D5 \u05E9\u05DC \u05D2\u05D9\u05D5\u05D5\u05DF \u05EA\u05E2\u05E1\u05D5\u05E7\u05EA\u05D9 \u05DE\u05E1\u05D9\u05D9\u05E2 \u05DC\u05D7\u05D1\u05E8\u05D4 \u05DC\u05D4\u05D9\u05D5\u05EA \u05DE\u05E0\u05D5\u05D4\u05DC\u05EA \u05E0\u05DB\u05D5\u05DF \u05D9\u05D5\u05EA\u05E8, \u05E2\u05DD \u05D0\u05D9\u05DB\u05D5\u05EA \u05D1\u05D9\u05E6\u05D5\u05E2 \u05D2\u05D1\u05D5\u05D4\u05D4 - \u05D5\u05D0\u05E3 \u05DE\u05E1\u05D9\u05D9\u05E2 \u05D1\u05D4\u05E9\u05D2\u05EA\u05DF \u05E9\u05DC \u05EA\u05D5\u05E6\u05D0\u05D5\u05EA \u05E2\u05E1\u05E7\u05D9\u05D5\u05EA \u05D8\u05D5\u05D1\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8. \u05DE\u05D7\u05E7\u05E8\u05D9\u05DD \u05E8\u05D1\u05D9\u05DD \u05E9\u05D1\u05D5\u05E6\u05E2\u05D5 \u05D1\u05E1\u05D5\u05D2\u05D9\u05D9\u05EA \u05D4\u05D2\u05D9\u05D5\u05D5\u05DF \u05D4\u05EA\u05E2\u05E1\u05D5\u05E7\u05EA\u05D9 \u05DB\u05D1\u05E8 \u05D4\u05D5\u05DB\u05D9\u05D7\u05D5 \u05DB\u05D9 \u05D2\u05D9\u05D5\u05D5\u05DF \u05D2\u05D9\u05DC\u05D9, \u05DE\u05D2\u05D6\u05E8\u05D9 \u05D5\u05DE\u05D2\u05D3\u05E8\u05D9 \u05DE\u05D1\u05D9\u05D0 \u05E2\u05DE\u05D5 \u05D2\u05DD \u05D4\u05E6\u05DC\u05D7\u05D4 \u05E2\u05E1\u05E7\u05D9\u05EA.",
